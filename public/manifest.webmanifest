{
  "name": "V and B Réseau",
  "short_name": "V and B Réseau",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f8bb09",
  "theme_color": "#000000",
  "icons": [
    {
      "src": "icone-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icone-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "share_target": {
    "action": "partage",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "titre",
      "text": "texte",
      "url": "lien",
      "files": [
        {
          "name": "photos",
          "accept": [
            "image/*"
          ]
        }
      ]
    }
  }
}
